includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 8
    treatPhpDocTypesAsCertain: false
    paths:
        - src
        - wp-edge-cache-headers.php
        - uninstall.php
        - autoload.php
    scanFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
